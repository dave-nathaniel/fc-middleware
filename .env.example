# Copy to .env and fill in. docker compose passes every value here to the containers.
# Never commit .env.

# --- Django ---
DJANGO_SECRET=change-me-to-a-long-random-string
DEBUG=False
# Host names / IPs the API answers on (comma separated). localhost and 127.0.0.1 are always allowed.
DJANGO_ALLOWED_HOSTS=20.56.133.194
# Full origins allowed to submit admin forms once served over HTTPS, e.g. https://middleware.foodconceptsplc.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (MySQL) ---
DB_ENGINE=django.db.backends.mysql
DB_NAME=middleware
DB_USER=middleware
DB_PASSWORD=change-me
# MySQL on the Docker host: host.docker.internal. With --profile local-db: db
DB_HOST=host.docker.internal
DB_PORT=3306
# Only used by the local-db profile
DB_ROOT_PASSWORD=change-me

# --- Email (sales sync reports) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SENDER=FC Middleware

# --- SAP ByD ---
SAP_URL=https://my350679.sapbydesign.com
SAP_USER=
SAP_PASS=
SAP_COMM_USER=
SAP_COMM_PASS=
SAP_TRANSPORT_TIMEOUT=30
SAP_OPERATION_TIMEOUT=120
BYD_COMPANY_ID=FC-0001

# --- ICG (legacy sales source) ---
ICG_HOST=
ICG_USER=
ICG_PASSWORD=

# --- Sales sync job (docker compose run --rm sales-sync) ---
SALES_AGGREGATION_EMAIL_TEMPLATE=assets/sales_aggregation_report_template.html
SALES_AGGREGATION_RESULT_EMAIL=["finance@foodconceptsplc.com"]
SALES_AGGREGATION_REPORTS_DIR=/app/reports

# --- Restroworks POS integration ---
POS_INTERNAL_VENDOR_CODES=178,179,180
RESTROWORKS_INVOICE_URL=
RESTROWORKS_AUTHORIZATION=
POS_DISPATCH_POLL_SECONDS=900
POS_MAX_RETRIES=6
POS_STALE_MINUTES=30
POS_BUSINESS_TIMEZONE=Africa/Lagos
BYD_POST_DELAY_SECONDS=5

# --- Celery ---
# Set by docker compose to the bundled Redis; only needed when running outside Docker.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
