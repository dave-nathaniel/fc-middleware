             log=f"Overdue alert task failed: {str(e)}"
         )
         return f"Task failed: {str(e)}"
+
+
+@shared_task(bind=True, max_retries=5, default_retry_delay=300)
+def report_byd_link_to_middleware(self, processed_order_id):
+    """
+    Tells the middleware which POS (Restroworks) purchase order lines went into the
+    ByD document created for a processed order, so it can send the final order back
+    to the POS as an invoice. Retries every 5 minutes if the middleware is unreachable.
+    """
+    order = ProcessedOrder.objects.get(id=processed_order_id)
+    if not order.byd_order_id:
+        return
+    document_type = "sales_order" if order.user.is_internal else "purchase_request"
+    lines = [
+        {
+            "warehouse": item.warehouse,
+            "series": item.series,
+            "orderID": item.orderID,
+            "reference": item.reference,
+            "quantity": str(item.totalQuantity),
+        }
+        for item in order.itemline_set.all()
+    ]
+    try:
+        response = requests.post(
+            f"{settings.MIDDLEWARE_BASE_URL}/api/v1/pos/purchase-orders/link",
+            json={"document_type": document_type, "document_id": order.byd_order_id, "lines": lines},
+            auth=(settings.MIDDLEWARE_USERNAME, settings.MIDDLEWARE_PASSWORD),
+            timeout=60,
+        )
+        response.raise_for_status()
+    except Exception as e:
+        raise self.retry(exc=e)
